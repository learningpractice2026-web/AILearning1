# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# ---- Which use case to run = folder name inside usecases/ ----
USECASE=meeting_notes

# ---- LLM provider: mock | openai | azure | gemini | ollama ----
# TCS-provided key: if the gateway is OpenAI-compatible -> LLM_PROVIDER=openai + LLM_BASE_URL=<gateway>/v1
#                   if it is an Azure OpenAI resource    -> LLM_PROVIDER=azure  + LLM_BASE_URL=https://<res>.openai.azure.com/
# mock = offline heuristic engine, no key needed (demo backup)
LLM_PROVIDER=mock
LLM_API_KEY=
# Azure: https://<resource>.openai.azure.com/   Gemini/Ollama/OpenAI: leave blank for defaults
LLM_BASE_URL=
AZURE_API_VERSION=2024-10-21

# Enterprise gateway extras (leave blank unless needed)
# Extra headers as JSON, e.g. {"x-api-key": "...", "Ocp-Apim-Subscription-Key": "..."}
LLM_EXTRA_HEADERS=
# Corporate CA certificate file if you get SSL errors on the office network, e.g. C:\certs\tcs-root.pem
LLM_CA_BUNDLE=

# Router: cheap model by default, strong model for long/complex extraction
# OpenAI:  gpt-4o-mini / gpt-4o          Azure: your DEPLOYMENT names
# Gemini:  gemini-2.5-flash / gemini-2.5-pro     Ollama: llama3.1 / llama3.1
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o
ROUTER_THRESHOLD_CHARS=12000
MAX_CHARS_PER_CALL=24000
# Large documents: chunks processed in parallel (lower it if the gateway rate-limits)
MAX_PARALLEL=4

# Embeddings for vector search (blank = BM25 keyword search only, works offline)
# OpenAI: text-embedding-3-small   Gemini: text-embedding-004   Ollama: nomic-embed-text
EMBED_MODEL=

# Speech-to-text (openai/azure). Azure: your whisper deployment name
STT_MODEL=whisper-1

# Multimodal: model that reads images / scanned PDFs (blank = LLM_MODEL_STRONG)
# OpenAI: gpt-4o   Gemini: gemini-2.5-flash   Azure: your gpt-4o deployment   Ollama: llava
VISION_MODEL=

# Orchestration: run the pipeline as a LangGraph state graph (false = plain Python, same result)
USE_LANGGRAPH=true

# Resilience + cost
FALLBACK_TO_MOCK=true
PRICE_IN_PER_1K=0.00015
PRICE_OUT_PER_1K=0.0006
DAILY_TOKEN_BUDGET=500000

# App
# DB_PATH=   (blank = data/<USECASE>.db, one database per use case)
AUTH_ENABLED=false
APP_USERS=admin:admin123:admin,lead:lead123:editor,viewer:view123:viewer
MASK_PII_DEFAULT=true
# Protect the REST API (header X-API-Key). Blank = open for local dev.
INBOUND_API_KEY=
